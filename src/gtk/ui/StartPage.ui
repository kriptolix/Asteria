<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="StartPage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Start Page</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">1</property>
        <property name="spacing">20</property>
        <property name="margin-top">20</property>
        <property name="margin-bottom">20</property>
        <property name="margin-start">20</property>
        <property name="margin-end">20</property>
        <child>
          <object class="GtkLabel" id="_presentation">
            <property name="label">Your Sites</property>
            <style>
              <class name="title-1"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkGridView" id="_grid_view">
            <property name="single-click-activate">true</property>
            <style>
              <class name="teste"/>
            </style>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>