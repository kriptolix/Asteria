<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="PrefSite" parent="AdwPreferencesGroup">
    <property name="margin-end">10</property>
    <property name="margin-start">10</property>
    <child>
      <object class="AdwExpanderRow">
        <property name="title" translatable="yes">Site</property>
        <property name="expanded">true</property>
        <style>
          <class name="view-bg"/>
        </style>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Main Settings</property>
            <property name="description" translatable="yes">Manages the site's core settings</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">10</property>
            <property name="margin-start">10</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Title:*</property>
                <child type="suffix">
                  <object class="GtkEntry" id="_site_title">
                    <property name="valign">3</property>
                    <property name="width-request">200</property>
                    <property name="xalign">0.5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Description:</property>
                <child type="suffix">
                  <object class="GtkEntry" id="_site_description">
                    <property name="valign">3</property>
                    <property name="width-request">200</property>
                    <property name="xalign">0.5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Url:</property>
                <property name="tooltip-text" translatable="yes">If you dont have it yet leave blank</property>
                <child type="suffix">
                  <object class="GtkEntry" id="_site_url">
                    <property name="valign">3</property>
                    <property name="placeholder-text" translatable="yes">www.my-site.com</property>
                    <property name="width-request">200</property>
                    <property name="xalign">0.5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Language:</property>
                <property name="tooltip-text" translatable="yes">If you dont have it yet leave blank</property>
                <child type="suffix">
                  <object class="GtkEntry" id="_site_lang">
                    <property name="valign">3</property>
                    <property name="width-request">200</property>
                    <property name="xalign">0.5</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Home Page:</property>
                <property name="tooltip-text" translatable="yes">the website's home page</property>
                <child type="suffix">
                  <object class="GtkBox">
                    <property name="spacing">10</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <child>
                      <object class="GtkBox">
                        <property name="homogeneous">true</property>
                        <style>
                          <class name="linked"/>
                        </style>
                        <child>
                          <object class="GtkButton" id="_choose_button">
                            <property name="icon-name" translatable="yes">folder-open-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Chosse a page</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="_blog_button">
                            <property name="icon-name" translatable="yes">view-list-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Use "Blog"</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="_site_home">
                        <property name="valign">3</property>
                        <property name="xalign">0.5</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>