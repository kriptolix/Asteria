<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MainMenu" parent="GtkPopoverMenu">
    <property name="autohide">True</property>
    <property name="visible">False</property>
    <property name="margin-end">100</property>
    <property name="menu-model">app_menu</property>
  </template>
  <menu id="app_menu">    
    <section>
      <item>
        <attribute name="label" translatable="yes">_Open Site</attribute>        
        <attribute name="action">app.open</attribute>        
      </item>
      <item>
        <attribute name="label" translatable="yes">_New Site</attribute>
        <attribute name="action">app.new</attribute>        
      </item>
      <item>
        <attribute name="label" translatable="yes">_Export Site</attribute>
        <attribute name="action">app.export</attribute>        
      </item>  
    </section>
    <section>      
      <item>
        <attribute name="label" translatable="yes">_About Asteria</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
