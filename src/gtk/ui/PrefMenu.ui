<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="PrefMenu" parent="AdwPreferencesGroup">
    <property name="margin-start">10</property>
    <property name="margin-end">10</property>
    <child>
      <object class="AdwExpanderRow">
        <property name="title" translatable="yes">Site Menu</property>
        <property name="expanded">false</property>
        <style>
          <class name="view-bg"/>
        </style>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Menu Settings</property>
            <property name="description" translatable="yes">Manage site menu. You can drag and drop to reorder</property>
            <property name="margin-bottom">10</property>
            <property name="margin-top">10</property>
            <property name="margin-end">10</property>
            <property name="margin-start">10</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Add a page</property>
                <child type="suffix">
                  <object class="GtkButton" id="_add_button">
                    <property name="valign">3</property>
                    <property name="icon-name">list-add-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Add a blog</property>
                <property name="subtitle" translatable="yes">"blog" is a special entry that corresponds to the page containing the list of posts.</property>
                <child type="suffix">
                  <object class="GtkButton" id="_blog_button">
                    <property name="valign">3</property>
                    <property name="icon-name">list-add-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="_trash_button">
                <property name="icon-name">user-trash-symbolic</property>
                <property name="focusable">false</property>
                <property name="halign">2</property>
                <property name="valign">3</property>
                <property name="hexpand">true</property>
                <property name="tooltip-text" translatable="yes">Drag a link to here to delet it</property>
                <property name="margin-top">10</property>
                <property name="margin-end">13</property>
                <style>
                  <class name="circular"/>
                  <class name="error"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkListBox" id="_menu_list">
                <property name="margin-top">10</property>
                <style>
                  <class name="boxed-list"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>