<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="SiteThumb" parent="GtkBox">
    <property name="orientation">1</property>
    
    <child>
      <object class="GtkOverlay">
        <property name="child">
          <object class="GtkFrame">
            <child>
              <object class="GtkPicture" id="_thumb">
                <property name="width-request">180</property>
                <property name="height-request">110</property>
                <style>
                  <class name="red"/>
                </style>
              </object>
            </child>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkBox">
            <property name="orientation">1</property>
            <child>
              <object class="GtkButton" id="_trash_button">
                <property name="icon-name">user-trash-symbolic</property>
                <property name="halign">2</property>
                <property name="valign">1</property>
                <property name="margin-end">5</property>
                <property name="margin-top">5</property>
                <property name="visible">false</property>
                <property name="sensitive">false</property>
                <style>
                  <class name="error"/>
                  <class name="circular"/>
                  <class name="background"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="_text">
                <property name="label">Teste</property>
                <property name="margin-bottom">10</property>
                <property name="vexpand">true</property>
                <property name="valign">2</property>
                <style>
                  <class name="body"/>
                  <class name="heading"/>
                  <class name="background"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>